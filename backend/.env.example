# 环境配置
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:5173

# 数据库 (PostgreSQL)
DATABASE_URL=postgresql://postgres:password@localhost:5432/frontend_quest?schema=public

# 缓存 (Redis)
REDIS_URL=redis://localhost:6379

# 安全 (JWT)
JWT_SECRET=super_secret_development_key_12345

# 微信公众号配置 (Webhook Callback)
WECHAT_TOKEN=your_wechat_webhook_token_here
# WECHAT_APP_ID=
# WECHAT_APP_SECRET=

# AI 接口配置
LLM_API_KEY=your_llm_api_key_here
# LLM_BASE_URL=https://api.openai.com/v1
